{
  "manifest_version": 3,
  "name": "EstudaAI - Conector AVA Anhanguera & Kroton",
  "version": "1.0.1",
  "description": "Sincronizador automático de disciplinas, atividades e tutor IA para o Portal Anhanguera, Unopar, Colaborar e AVA KLS.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.avaeduc.com.br/*",
    "https://*.colaboraread.com.br/*",
    "https://*.anhanguera.com/*",
    "https://*.kroton.com.br/*",
    "https://*.kroton.com/*",
    "https://*.unopar.com.br/*",
    "https://*.unopar.br/*",
    "https://*.pitagoras.com.br/*",
    "https://*.pitagoras.br/*",
    "https://*.ampli.me/*",
    "https://estudaai.pages.dev/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "http://localhost:3002/*",
    "http://localhost:3003/*",
    "http://127.0.0.1:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EstudaAI - Conector Acadêmico",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.avaeduc.com.br/*",
        "https://*.colaboraread.com.br/*",
        "https://*.anhanguera.com/*",
        "https://*.kroton.com.br/*",
        "https://*.kroton.com/*",
        "https://*.unopar.com.br/*",
        "https://*.unopar.br/*",
        "https://*.pitagoras.com.br/*",
        "https://*.pitagoras.br/*",
        "https://*.ampli.me/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://estudaai.pages.dev/*",
        "http://localhost:3000/*",
        "http://localhost:3001/*",
        "http://localhost:3002/*",
        "http://localhost:3003/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["estudaai-bridge.js"],
      "run_at": "document_end"
    }
  ]
}
